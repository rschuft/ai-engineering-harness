{
  "description": "Claude Code 2.1.319 headless, tool-less, isolated from project and personal customization as far as flags allow (P-01.2). The prompt goes on stdin.",
  "argv": [
    "claude", "-p",
    "--output-format", "stream-json", "--verbose",
    "--tools", "",
    "--safe-mode",
    "--strict-mcp-config", "--mcp-config", "{\"mcpServers\":{}}",
    "--setting-sources", "project",
    "--no-session-persistence",
    "--disable-slash-commands",
    "--permission-prompts", "none",
    "--max-budget-usd", "1",
    "--model", "claude-opus-5-5",
    "--system-prompt", "{system_prompt}"
  ],
  "parser": "claude-stream-json",
  "drop_env_prefixes": ["CLAUDE"],
  "drop_env": ["AI_AGENT"],
  "timeout_s": 900
}
