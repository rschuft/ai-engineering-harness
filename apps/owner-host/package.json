{
  "name": "aieh-owner-host",
  "version": "0.0.0",
  "private": true,
  "description": "Owner host shell (plan leaf U-01.1): navigation, session identity, assistant-ui chat and embedded Agent Canvas in one React app. Not connected to any backend.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.32",
    "@openhands/agent-canvas": "1.36.0",
    "i18next": "26.5.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
