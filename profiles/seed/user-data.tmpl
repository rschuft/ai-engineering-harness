  - path: /usr/local/sbin/aieh-agent-server-keycheck
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/python3
      # aieh-agent-server-keycheck: ExecStartPre of aieh-agent-server.service (S-01.3.1). The
      # 1.60.1 server treats an empty session-key list as "unsecured" (Config.session_api_keys)
      # and drops empty values, so a lost key must stop the start instead of opening the API.
      # It refuses unless the session key and OH_SECRET_KEY are 43-character token_urlsafe
      # values, distinct, and no other session-key variable is set. Names only are printed.
      import os
      import re
      import sys

      VALUE = re.compile(r'^[A-Za-z0-9_-]{43}$')
      REQUIRED = ('OH_SESSION_API_KEYS_0', 'OH_SECRET_KEY')
      OTHER_KEY = re.compile(r'^(OH_SESSION_API_KEYS_[0-9]+|SESSION_API_KEY)$')


      def problems(environ):
          out = [name + ' is missing or not a 43-character token' for name in REQUIRED
                 if not VALUE.match(environ.get(name, ''))]
          if not out and environ[REQUIRED[0]] == environ[REQUIRED[1]]:
              out.append(' and '.join(REQUIRED) + ' are equal')
          out += [name + ' is set (one session key only)' for name in sorted(environ)
                  if OTHER_KEY.match(name) and name != REQUIRED[0]]
          return out


      if __name__ == '__main__':
          found = problems(dict(os.environ))
          if found:
              print('aieh-agent-server-keycheck: refused: ' + '; '.join(found), flush=True)
              sys.exit(1)
          print('aieh-agent-server-keycheck: ok', flush=True)
  - path: /usr/local/sbin/aieh-agent-server-ready
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/python3
      # aieh-agent-server-ready: ExecStartPost of aieh-agent-server.service (F-04.1). The
      # server exposes no start notification, so this polls GET /ready on its loopback
      # listener every 0.5 s until it answers 200, under the ceiling given in argv. It sends
      # no credential (the route is unauthenticated) and prints only the outcome.
      import http.client
      import sys
      import time

      host, port, ceiling = sys.argv[1], int(sys.argv[2]), float(sys.argv[3])
      deadline = time.monotonic() + ceiling
      while True:
          status = None
          try:
              conn = http.client.HTTPConnection(host, port, timeout=5)
              conn.request('GET', '/ready')
              response = conn.getresponse()
              response.read()
              status = response.status
              conn.close()
          except OSError:
              pass
          if status == 200:
              print('aieh-agent-server-ready: ready', flush=True)
              sys.exit(0)
          if time.monotonic() >= deadline:
              print('aieh-agent-server-ready: not ready within ' + str(ceiling) + ' s (last status ' +
                    str(status) + ')', flush=True)
              sys.exit(1)
          time.sleep(0.5)
  - path: /etc/systemd/system/aieh-agent-server.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=OpenHands Agent Server 1.60.1 (AIEH F-04.1 inspection workload, guest loopback only)
      ConditionFileNotEmpty=/etc/aieh/provision.json
      ConditionPathExists=/opt/aieh/agent-server/agent-server
      ConditionPathExists=/etc/aieh/agent-server/secrets.env
      Wants=docker.service
      After=docker.service
      RequiresMountsFor=/srv/scratch

      [Service]
      Type=exec
      User=openhands
      Group=openhands
      EnvironmentFile=/etc/aieh/agent-server/secrets.env
      Environment=OPENHANDS_AGENT_SERVER_CONFIG_PATH=/etc/aieh/agent-server/config.json
      Environment=OH_PERSISTENCE_DIR=/srv/scratch/openhands/persistence
      Environment=HOME=/srv/scratch/openhands/home
      Environment=TMPDIR=/srv/scratch/openhands/tmp
      Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
      Environment=LANG=C.UTF-8
      WorkingDirectory=/srv/scratch/openhands/home
      ExecStartPre=/usr/bin/python3 -I /usr/local/sbin/aieh-agent-server-keycheck
      ExecStart=/opt/aieh/agent-server/agent-server --host 127.0.0.1 --port 8000
      ExecStartPost=/usr/bin/python3 -I /usr/local/sbin/aieh-agent-server-ready 127.0.0.1 8000 280
      TimeoutStartSec=300
      Restart=on-failure
      RestartSec=5
      StandardOutput=journal
      StandardError=journal
      NoNewPrivileges=yes
      CapabilityBoundingSet=
      AmbientCapabilities=
      ProtectSystem=strict
      ReadWritePaths=/srv/scratch/openhands
      ProtectHome=yes
      PrivateTmp=yes
      PrivateDevices=yes
      ProtectKernelTunables=yes
      ProtectKernelModules=yes
      ProtectKernelLogs=yes
      ProtectControlGroups=yes
      ProtectClock=yes
      ProtectHostname=yes
      ProtectProc=invisible
      RestrictSUIDSGID=yes
      RestrictRealtime=yes
      RestrictNamespaces=yes
      LockPersonality=yes
      SystemCallArchitectures=native
      SystemCallFilter=@system-service
      RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
      IPAddressDeny=any
      IPAddressAllow=localhost
      UMask=0077

      [Install]
      WantedBy=multi-user.target
fs_setup:
  - label: scratch
    filesystem: ext4
    device: {{scratch_device}}
    partition: none
mounts:
  - [LABEL=scratch, /srv/scratch, ext4, "defaults,nofail", "0", "2"]
runcmd:
  - [install, -d, -o, agent, -g, agent, -m, "0750", /srv/scratch/agent]
  - [install, -d, -o, agent, -g, agent, -m, "0750", /home/agent/exchange]
  - [sh, -c, "if [ -s /etc/aieh/provision.json ]; then install -d -o root -g root -m 0755 /var/lib/aieh /var/lib/aieh/provision && systemctl enable --now aieh-provision.path; fi"]
