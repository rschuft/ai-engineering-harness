    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/python3
      # aieh-agent-server-ready: ExecStartPost of aieh-agent-server.service (F-04.1). The
      # server exposes no start notification, so this polls GET /ready on its loopback
      # listener every 0.5 s until it answers 200, under the ceiling given in argv. It sends
      # no credential (the route is unauthenticated) and prints only the outcome.
      import http.client
      import sys
      import time

      host, port, ceiling = sys.argv[1], int(sys.argv[2]), float(sys.argv[3])
      deadline = time.monotonic() + ceiling
      while True:
          status = None
          try:
              conn = http.client.HTTPConnection(host, port, timeout=5)
              conn.request('GET', '/ready')
              response = conn.getresponse()
              response.read()
              status = response.status
              conn.close()
          except OSError:
              pass
          if status == 200:
              print('aieh-agent-server-ready: ready', flush=True)
              sys.exit(0)
          if time.monotonic() >= deadline:
              print('aieh-agent-server-ready: not ready within ' + str(ceiling) + ' s (last status ' +
                    str(status) + ')', flush=True)
              sys.exit(1)
          time.sleep(0.5)
