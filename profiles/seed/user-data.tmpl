#cloud-config
# Seed template for strong-tier execution guests (profiles P5, P8). It holds only
# the per-instance public key and non-secret configuration. The generator
# substitutes exactly three placeholders: the agent's public key, the profile's
# scratch device and the provisioning manifest (base64; empty for an ordinary guest).
# profiles/seed/README.md names them. This comment names none of them.
# The provisioning files (F-04.1, decision 0006) are inert without a manifest: both
# units carry ConditionFileNotEmpty on it, and runcmd enables the trigger only when
# the manifest is not empty.
users:
  - name: agent
    gecos: AI Engineering Harness agent
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - {{agent_ssh_public_key}}
disable_root: true
ssh_pwauth: false
ssh_deletekeys: true
ssh_genkeytypes: [ed25519]
package_update: false
package_upgrade: false
timezone: Etc/UTC
write_files:
  - path: /etc/ssh/sshd_config.d/10-aieh.conf
    owner: root:root
    permissions: '0644'
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      AllowUsers agent
      AllowAgentForwarding no
      AllowTcpForwarding no
      X11Forwarding no
      PermitTunnel no
  - path: /etc/aieh/provision.json
    owner: root:root
    permissions: '0600'
    encoding: b64
    content: "{{provision_manifest}}"
  - path: /usr/local/sbin/aieh-provision
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/python3
      # aieh-provision: the single-use root provisioning step of F-04.1 (decision 0006).
      # Seeded by cloud-init; never downloaded. Modes:
      #   provision  run once by aieh-provision.service when the host's READY marker appears:
      #              copy the upload into a root-only staging directory, verify every sha256
      #              against the seeded manifest, write daemon.json and the sysctl drop-in,
      #              install the packages with apt from the local files, replace containerd's
      #              packaged config (CRI plugin off), docker load the image, check its ID, fix its
      #              tag, run it once, install the Agent Server (system user openhands, the
      #              release binary, its scratch directories and its non-secret config), generate
      #              its two guest-local secrets, start its unit, enable the facts unit, delete
      #              the staging directory and the upload, disable the trigger, then write
      #              RESULT.json (last).
      #   facts      run at every boot by aieh-docker-facts.service: a read-only report of the
      #              daemon, the image store, the sockets and the Agent Server for inspect.
      #   conversation-facts
      #              run by aieh-conversation-facts.service when agent creates the request file
      #              (F-04.2; rate-bounded by its units): a read-only report of the containers
      #              carrying the Agent Server's owner label (docker ps and docker container
      #              inspect only), the TCP listeners and the stored conversations. It takes no
      #              input from the request but its existence.
      # It reads only the seeded manifest and the files it names. It prints step names and
      # outcomes only (journal and console). The two secrets it generates are written only to
      # their root-only environment file (and the session key to its agent-readable file);
      # records carry their fingerprints, never their values.
      import grp
      import hashlib
      import json
      import os
      import pwd
      import re
      import secrets
      import shutil
      import stat
      import subprocess
      import sys
      import time

      MANIFEST = '/etc/aieh/provision.json'
      UPLOAD = '/srv/scratch/agent/provision'
      READY = 'READY'
      STAGING = '/var/lib/aieh/provision-staging'
      RESULT_DIR = '/var/lib/aieh/provision'
      RESULT = RESULT_DIR + '/RESULT.json'
      FACTS_DIR = '/run/aieh'
      FACTS = FACTS_DIR + '/docker-facts.json'
      DAEMON_JSON = '/etc/docker/daemon.json'
      SYSCTL_FILE = '/etc/sysctl.d/90-aieh-moby.conf'
      CONTAINERD_CONFIG = '/etc/containerd/config.toml'
      MOBY_PROCESSES = ('dockerd', 'containerd', 'docker-proxy', 'containerd-shim')
      PATH_UNIT = 'aieh-provision.path'
      PATH_UNIT_FILE = '/etc/systemd/system/' + PATH_UNIT
      FACTS_UNIT = 'aieh-docker-facts.service'
      AGENT = 'agent'
      MANIFEST_SCHEMA = 'ai-engineering-harness/profiles/provision-manifest/v1'
      RESULT_SCHEMA = 'ai-engineering-harness/profiles/provision-result/v1'
      FACTS_SCHEMA = 'ai-engineering-harness/profiles/moby-facts/v1'
      NAME = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._+~-]{0,200}$')
      HEX64 = re.compile(r'^[0-9a-f]{64}$')
      DIGEST = re.compile(r'^sha256:[0-9a-f]{64}$')
      ROLES = ('deb', 'image-archive', 'release-binary')
      MODULES = ('overlay', 'br_netfilter', 'bridge', 'veth', 'nf_tables', 'nf_nat', 'nft_chain_nat',
                 'iptable_nat', 'xt_MASQUERADE')
      MOBY_SOCKET_DIRS = ('/run/docker', '/run/containerd')
      MOBY_SOCKETS = ('/run/docker.sock',)
      ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8', 'HOME': '/root',
             'DEBIAN_FRONTEND': 'noninteractive', 'DEBCONF_NONINTERACTIVE_SEEN': 'true'}
      # docker's Go template for one JSON document, assembled so that no doubled brace occurs in
      # this file (the seed generator treats doubled braces as placeholders)
      GO_JSON = '{' + '{json .}' + '}'
      # The Agent Server (F-04.1 slice (c)): paths equal provisioning.agent_server of the profile.
      AS_USER = 'openhands'
      AS_SHELL = '/usr/sbin/nologin'
      AS_BINARY = '/opt/aieh/agent-server/agent-server'
      AS_CONFIG = '/etc/aieh/agent-server/config.json'
      AS_SECRETS = '/etc/aieh/agent-server/secrets.env'
      AS_SESSION_DIR = '/var/lib/aieh/agent-server'
      AS_SESSION_KEY = AS_SESSION_DIR + '/session.key'
      AS_UNIT = 'aieh-agent-server.service'
      AS_PROCESS = 'agent-server'
      AS_SECRET_VARS = ('OH_SECRET_KEY', 'OH_SESSION_API_KEYS_0')
      SECRET_VALUE = re.compile(r'^[A-Za-z0-9_-]{43}$')
      FINGERPRINT_PREFIX = b'aieh-secret-fingerprint/v1\n'
      AS_UNIT_PROPERTIES = ('LoadState', 'ActiveState', 'SubState', 'UnitFileState', 'MainPID',
                            'NRestarts', 'User', 'Group', 'Environment', 'EnvironmentFiles',
                            'NoNewPrivileges', 'ProtectSystem', 'ProtectHome', 'PrivateTmp',
                            'PrivateDevices', 'ProtectProc', 'RestrictNamespaces', 'RestrictSUIDSGID',
                            'CapabilityBoundingSet', 'AmbientCapabilities', 'IPAddressDeny',
                            'IPAddressAllow', 'RestrictAddressFamilies', 'SystemCallArchitectures',
                            'UMask', 'ReadWritePaths')
      # start-up log lines worth keeping as evidence (egress attempts, failures); the log is
      # read by root, the secret values are redacted and counted before anything is written
      LOG_NOTE = re.compile(r'(?i)(error|warn|fail|refused|unreachable|resolv|timed? ?out|connect|'
                            r'https?://|network|dns|docker|telemetry|listen|start)')
      # On-demand conversation facts (F-04.2): the Agent Server's conversation containers and
      # their stored state, written by root when agent creates the request file. Its existence
      # is the only input: it is removed, never read. Equal to provisioning.agent_server
      # .conversations.facts of the profile.
      REQUEST_DIR = '/var/lib/aieh/facts-request'
      REQUEST = REQUEST_DIR + '/conversation-facts'
      CONV_FACTS = FACTS_DIR + '/conversation-facts.json'
      CONV_FACTS_SCHEMA = 'ai-engineering-harness/profiles/conversation-facts/v1'
      CONV_FACTS_UNIT = 'aieh-conversation-facts.service'
      CONV_PATH_UNIT = 'aieh-conversation-facts.path'
      # docker_runtime/registry.py (1.60.1): the label every conversation container carries
      OWNER_LABEL = 'ai.openhands.runtime-owner'
      AS_PERSISTENCE = '/srv/scratch/openhands/persistence'
      # environment variables of a conversation container whose values are secrets (its own
      # OH_SECRET_KEY and session key); reported by name only, redacted wherever they occur
      CONTAINER_SECRET_VARS = ('OH_SECRET_KEY', 'OH_SESSION_API_KEYS_0')
      SECRET_NAME = re.compile(r'(?i)(key|secret|token|password|credential)')
      CONTAINER_ID = re.compile(r'^[0-9a-f]{64}$')
      PROXY_PROCESSES = ('docker-proxy', 'dockerd')
      # S-01.3.1: the management API admission (provisioning.agent_server.admission)
      GUARD = '/usr/local/sbin/aieh-container-guard'
      GUARD_UNIT = 'aieh-container-guard.service'
      GUARD_CHAIN = 'AIEH-CONTAINER-GUARD'
      GUARD_LOG_PREFIX = 'aieh-container-guard: '
      GUARD_TOOLS = ('iptables', 'ip6tables')
      GUARD_DROPIN = '/etc/systemd/system/docker.service.d/10-aieh-container-guard.conf'
      KEYCHECK = '/usr/local/sbin/aieh-agent-server-keycheck'
      UNIT_STATE = ('LoadState', 'ActiveState', 'SubState', 'Result', 'UnitFileState')
      INVENTORY_MAX = 400
      HASH_MAX = 16 << 20
      LOG_TAIL = 1 << 20


      class Failed(Exception):
          pass


      def now():
          return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())


      def say(text):
          print('aieh-provision: ' + text, flush=True)


      def tail(text, limit=2000):
          text = (text or '').strip()
          return text[-limit:]


      def run(argv, timeout, cwd=None):
          try:
              r = subprocess.run(argv, cwd=cwd, env=ENV, stdin=subprocess.DEVNULL,
                                 capture_output=True, timeout=timeout, check=False)
          except subprocess.TimeoutExpired:
              return 124, '', argv[0] + ': timed out after ' + str(timeout) + ' s'
          except OSError as exc:
              return 127, '', argv[0] + ': ' + str(exc)
          return r.returncode, r.stdout.decode('utf-8', 'replace'), r.stderr.decode('utf-8', 'replace')


      def must(step, argv, timeout, cwd=None):
          rc, out, err = run(argv, timeout, cwd)
          if rc != 0:
              raise Failed(step + ': ' + ' '.join(argv[:3]) + ' exited ' + str(rc) + ': ' +
                           tail(err or out, 600))
          return out


      def json_lines(text):
          return [json.loads(line) for line in text.splitlines() if line.strip()]


      def write_json(path, data, mode):
          tmp = path + '.partial'
          if os.path.lexists(tmp):
              os.unlink(tmp)
          fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
          with os.fdopen(fd, 'w', encoding='utf-8') as handle:
              json.dump(data, handle, indent=2, sort_keys=True)
              handle.write('\n')
              handle.flush()
              os.fsync(handle.fileno())
          os.chmod(tmp, mode)
          os.rename(tmp, path)


      def sha256_path(path):
          digest = hashlib.sha256()
          fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
          with os.fdopen(fd, 'rb') as handle:
              for block in iter(lambda: handle.read(1 << 20), b''):
                  digest.update(block)
          return digest.hexdigest()


      def read_text(path):
          try:
              with open(path, encoding='utf-8') as handle:
                  return handle.read()
          except OSError as exc:
              return 'unreadable: ' + str(exc)


      def ipv6_state():
          rc, out, err = run(['ip', '-6', '-o', 'addr', 'show'], 30)
          lines = [line for line in out.splitlines() if line.split()[1:2] != ['lo']]
          return {'docker0_disable_ipv6': read_text('/proc/sys/net/ipv6/conf/docker0/disable_ipv6').strip(),
                  'addresses': lines if rc == 0 else ['ip exited ' + str(rc) + ': ' + tail(err, 300)]}


      def moby_tcp_listeners():
          rc, out, err = run(['ss', '-ltnpH'], 30)
          if rc != 0:
              raise Failed('listeners: ss exited ' + str(rc) + ': ' + tail(err, 300))
          lines = out.splitlines()
          return lines, [line for line in lines if any('(("' + p in line for p in MOBY_PROCESSES)]


      def loaded_modules():
          names = set()
          with open('/proc/modules', encoding='ascii') as handle:
              for line in handle:
                  names.add(line.split(' ', 1)[0])
          with open('/proc/filesystems', encoding='ascii') as handle:
              overlay_fs = any(line.split()[-1] == 'overlay' for line in handle if line.strip())
          return {'loaded': sorted(m for m in MODULES if m in names), 'overlay_filesystem': overlay_fs}


      # ---------------------------------------------------------------- the manifest

      def load_manifest():
          st = os.lstat(MANIFEST)
          if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o077:
              raise Failed('manifest: ' + MANIFEST + ' is not a root-only regular file')
          with open(MANIFEST, encoding='utf-8') as handle:
              manifest = json.load(handle)
          if manifest.get('schema') != MANIFEST_SCHEMA:
              raise Failed('manifest: schema is not ' + MANIFEST_SCHEMA)
          files = manifest.get('files')
          if not isinstance(files, list) or not files:
              raise Failed('manifest: no files')
          names = set()
          for entry in files:
              name, size, digest = entry.get('name'), entry.get('size'), entry.get('sha256')
              if not isinstance(name, str) or not NAME.match(name) or name == READY or name in names:
                  raise Failed('manifest: bad or repeated file name ' + repr(name))
              if not isinstance(size, int) or size < 0 or not HEX64.match(str(digest)):
                  raise Failed('manifest: ' + name + ' needs a size and a sha256')
              if entry.get('role') not in ROLES:
                  raise Failed('manifest: ' + name + ' has an unknown role')
              names.add(name)
          image = manifest.get('image') or {}
          if not DIGEST.match(str(image.get('id'))) or image.get('archive') not in names or \
                  not isinstance(image.get('local_tag'), str) or \
                  not isinstance(image.get('archive_repo_tags'), list):
              raise Failed('manifest: image needs id, archive, local_tag and archive_repo_tags')
          docker = manifest.get('docker') or {}
          if not isinstance(docker.get('daemon_json'), dict) or not docker.get('server_version') or \
                  not isinstance(docker.get('sysctl'), str) or \
                  not isinstance(docker.get('containerd_config'), str):
              raise Failed('manifest: docker needs daemon_json, server_version, sysctl and '
                           'containerd_config')
          server = manifest.get('agent_server') or {}
          binary = server.get('binary') or {}
          by_name = {f['name']: f for f in files}
          if by_name.get(binary.get('name'), {}).get('role') != 'release-binary' or \
                  by_name[binary['name']]['sha256'] != binary.get('sha256'):
              raise Failed('manifest: agent_server.binary must name the release-binary file')
          dirs = server.get('directories')
          if not isinstance(server.get('config'), dict) or not isinstance(dirs, list) or not dirs or \
                  not all(isinstance(d, dict) and str(d.get('path', '')).startswith('/srv/scratch/') and
                          '..' not in str(d['path']).split('/') and
                          re.match(r'^[0-7]{3}$', str(d.get('mode', ''))) for d in dirs) or \
                  not isinstance(server.get('home'), str) or \
                  not isinstance((server.get('listener') or {}).get('port'), int):
              raise Failed('manifest: agent_server needs config, directories on /srv/scratch, home '
                           'and listener')
          return manifest


      # ---------------------------------------------------------------- facts (every boot)

      def socket_facts():
          out = []
          paths = list(MOBY_SOCKETS)
          for top in MOBY_SOCKET_DIRS:
              for dirpath, dirnames, filenames in os.walk(top):
                  for name in sorted(dirnames + filenames):
                      path = os.path.join(dirpath, name)
                      try:
                          if stat.S_ISSOCK(os.lstat(path).st_mode):
                              paths.append(path)
                      except OSError:
                          pass
          for path in sorted(set(paths)):
              try:
                  st = os.lstat(path)
              except OSError:
                  out.append({'path': path, 'state': 'absent'})
                  continue
              out.append({'path': path, 'state': 'socket' if stat.S_ISSOCK(st.st_mode) else 'other',
                          'owner': pwd.getpwuid(st.st_uid).pw_name,
                          'group': grp.getgrgid(st.st_gid).gr_name,
                          'mode': format(stat.S_IMODE(st.st_mode), 'o')})
          return out


      def docker_json(argv, many=False):
          rc, out, err = run(['docker'] + argv, 120)
          if rc != 0:
              return {'rc': rc, 'error': tail(err or out, 600)}
          try:
              return json_lines(out) if many else json.loads(out)
          except ValueError:
              return {'rc': rc, 'error': 'unparsable: ' + tail(out, 600)}


      def fingerprint(value):
          return hashlib.sha256(FINGERPRINT_PREFIX + value.encode('ascii')).hexdigest()


      def secret_values():
          """{variable: value} from the root-only environment file; {} before it exists."""
          try:
              with open(AS_SECRETS, encoding='ascii') as handle:
                  text = handle.read()
          except OSError:
              return {}
          out = {}
          for line in text.splitlines():
              name, sep, value = line.partition('=')
              if sep and name in AS_SECRET_VARS:
                  out[name] = value
          return out


      def redact(text, values):
          """The text with every secret value replaced by its variable's name, and the count."""
          counts = {}
          for name, value in values.items():
              counts[name] = text.count(value) if value else 0
              if value:
                  text = text.replace(value, '<' + name + ' redacted>')
          return text, counts


      def stat_entry(path):
          try:
              st = os.lstat(path)
          except OSError:
              return {'path': path, 'state': 'absent'}
          kind = 'directory' if stat.S_ISDIR(st.st_mode) else 'file' if stat.S_ISREG(st.st_mode) \
              else 'other'
          try:
              owner = pwd.getpwuid(st.st_uid).pw_name
          except KeyError:
              owner = str(st.st_uid)
          try:
              group = grp.getgrgid(st.st_gid).gr_name
          except KeyError:
              group = str(st.st_gid)
          return {'path': path, 'state': kind, 'owner': owner, 'group': group,
                  'mode': format(stat.S_IMODE(st.st_mode), 'o')}


      def unit_show(unit, names):
          rc, out, err = run(['systemctl', 'show', unit] + ['--property=' + n for n in names], 60)
          props = {}
          for line in out.splitlines():
              key, sep, value = line.partition('=')
              if sep:
                  props[key] = value
          return props


      def unit_journal(values):
          rc, out, err = run(['journalctl', '-b', '-u', AS_UNIT, '-o', 'short-iso', '--no-pager'], 120)
          text, counts = redact(out if rc == 0 else '', values)
          lines = text.splitlines()
          noted = [line[:400] for line in lines[30:] if LOG_NOTE.search(line)]
          return {'rc': rc, 'lines': len(lines), 'secret_occurrences': counts,
                  'head': [line[:400] for line in lines[:30]], 'noted': noted[-60:]}


      def process_facts(pid, values):
          out = {'pid': pid}
          try:
              with open('/proc/' + pid + '/status', encoding='utf-8') as handle:
                  status = dict(line.split(':', 1) for line in handle if ':' in line)
              out['name'] = status.get('Name', '').strip()
              uid = int(status.get('Uid', '-1').split()[0])
              gid = int(status.get('Gid', '-1').split()[0])
              out['user'] = pwd.getpwuid(uid).pw_name
              out['group'] = grp.getgrgid(gid).gr_name
              out['groups'] = sorted(grp.getgrgid(int(g)).gr_name for g in status.get('Groups', '').split())
              out['exe'] = os.readlink('/proc/' + pid + '/exe')
              with open('/proc/' + pid + '/environ', 'rb') as handle:
                  pairs = [p.decode('utf-8', 'replace').partition('=') for p in handle.read().split(b'\0') if p]
              # names only; the values of DOCKER_* (the engine endpoint) with secrets redacted
              out['environment_names'] = sorted(p[0] for p in pairs)
              out['docker_environment'] = {p[0]: redact(p[2], values)[0] for p in pairs
                                           if p[0].startswith('DOCKER_')}
          except (OSError, KeyError, ValueError) as exc:
              out['error'] = type(exc).__name__ + ': ' + str(exc)
          return out


      def agent_server_facts(manifest):
          """Root-only facts of the Agent Server for inspect. No secret value is returned: the
          two secrets are read only to compute their fingerprints and to count and redact any
          occurrence in the start-up log and the records."""
          conf = manifest['agent_server']
          values = secret_values()
          unit = unit_show(AS_UNIT, AS_UNIT_PROPERTIES)
          procs_path = '/sys/fs/cgroup/system.slice/' + AS_UNIT + '/cgroup.procs'
          try:
              with open(procs_path, encoding='ascii') as handle:
                  pids = [p.strip() for p in handle if p.strip()]
          except OSError:
              pids = []
          try:
              user = pwd.getpwnam(AS_USER)
              account = {'name': user.pw_name, 'uid': user.pw_uid, 'home': user.pw_dir,
                         'shell': user.pw_shell, 'groups': run(['id', '-nG', AS_USER], 30)[1].split(),
                         'password': (run(['passwd', '-S', AS_USER], 30)[1].split() + ['', ''])[1]}
          except KeyError:
              account = {'name': AS_USER, 'state': 'absent'}
          paths = []
          for d in conf['directories']:
              entry = stat_entry(d['path'])
              rc, mnt, err = run(['findmnt', '-n', '-o', 'TARGET,FSTYPE', '--target', d['path']], 30)
              entry['mount'] = mnt.split()
              paths.append(entry)
          as_user = ['setpriv', '--reuid=' + AS_USER, '--regid=' + AS_USER, '--init-groups',
                     '--reset-env', '--']
          rc, ctx_out, err = run(as_user + ['docker', 'context', 'inspect'], 60)
          try:
              endpoint = json.loads(ctx_out)[0]['Endpoints']['docker']['Host']
          except (ValueError, LookupError, TypeError):
              endpoint = {'rc': rc, 'error': tail(err or ctx_out, 300)}
          rc, ver_out, err = run(as_user + ['docker', 'version', '--format', GO_JSON], 60)
          try:
              server_version = (json.loads(ver_out).get('Server') or {}).get('Version')
          except (ValueError, AttributeError):
              server_version = {'rc': rc, 'error': tail(err or ver_out, 300)}
          try:
              with open(AS_CONFIG, encoding='utf-8') as handle:
                  config = json.load(handle)
          except (OSError, ValueError) as exc:
              config = {'error': str(exc)}
          scanned = {}
          for path in (RESULT, AS_CONFIG, MANIFEST, AS_SESSION_KEY, '/var/log/cloud-init.log',
                       '/var/log/cloud-init-output.log'):
              text = read_text(path)
              counts = redact(text, values)[1]
              if path == AS_SESSION_KEY:          # the session key file holds that key by design
                  counts.pop('OH_SESSION_API_KEYS_0', None)
              scanned[path] = counts
          return {'unit': unit, 'enabled': run(['systemctl', 'is-enabled', AS_UNIT], 30)[1].strip(),
                  'processes': [process_facts(p, values) for p in pids], 'account': account,
                  'binary': dict(stat_entry(AS_BINARY), sha256=sha256_path(AS_BINARY)
                                 if os.path.isfile(AS_BINARY) else None),
                  'config': {'file': stat_entry(AS_CONFIG), 'content': config},
                  'secrets': {'env_file': stat_entry(AS_SECRETS),
                              'variables': sorted(values),
                              'values_valid': len(values) == len(AS_SECRET_VARS) and
                              len(set(values.values())) == len(values) and
                              all(SECRET_VALUE.match(v) for v in values.values()),
                              'fingerprints': {k: fingerprint(v) for k, v in sorted(values.items())},
                              'session_dir': stat_entry(AS_SESSION_DIR),
                              'session_key': stat_entry(AS_SESSION_KEY),
                              'session_key_matches': read_text(AS_SESSION_KEY) ==
                              values.get('OH_SESSION_API_KEYS_0'),
                              'occurrences': scanned},
                  'paths': paths, 'engine': {'docker_context_host': endpoint,
                                             'docker_server_version_as_openhands': server_version},
                  'journal': unit_journal(values)}


      def admission_facts():
          """S-01.3.1: the container guard (unit, rules of both families, docker.service's
          dependency on it), the default bridge's icc and the Agent Server's key check."""
          rc, out, err = run(['/usr/bin/python3', '-I', GUARD, 'check'], 120)
          try:
              rules = json.loads(out.strip().splitlines()[-1])
          except (IndexError, ValueError):
              rules = {'ok': False, 'error': tail(err or out, 300)}
          deps = unit_show('docker.service', ('Requires', 'After'))
          bridge = docker_json(['network', 'inspect', 'bridge', '--format', GO_JSON])
          options = bridge.get('Options') if isinstance(bridge, dict) else None
          pre = unit_show(AS_UNIT, ('ExecStartPre',)).get('ExecStartPre') or ''
          keycheck = {'script': stat_entry(KEYCHECK), 'exec_start_pre': KEYCHECK in pre}
          return {'guard_unit': unit_show(GUARD_UNIT, UNIT_STATE), 'rules': rules,
                  'dropin': stat_entry(GUARD_DROPIN),
                  'docker_requires_guard': GUARD_UNIT in str(deps.get('Requires', '')).split(),
                  'docker_after_guard': GUARD_UNIT in str(deps.get('After', '')).split(),
                  'bridge_enable_icc': (options or {}).get('com.docker.network.bridge.enable_icc')
                  if isinstance(options, dict) else bridge,
                  'keycheck': keycheck}


      def admission_counters():
          """S-01.3.1: what was refused since boot: the guard's per-rule packet counters and
          its kernel log lines (rate-limited), and the Agent Server's own refusal log lines."""
          out = {}
          for tool in GUARD_TOOLS:
              rc, text, err = run([tool, '-w', '-n', '-v', '-x', '-L', GUARD_CHAIN], 60)
              rows = []
              for line in text.splitlines()[2:] if rc == 0 else []:
                  f = line.split()
                  if len(f) >= 3 and f[0].isdigit():
                      rows.append({'packets': int(f[0]), 'bytes': int(f[1]), 'target': f[2]})
              out[tool] = rows if rc == 0 else {'rc': rc, 'error': tail(err, 300)}
          rc, text, err = run(['journalctl', '-k', '-b', '--no-pager', '-o', 'short-iso',
                               '-g', GUARD_LOG_PREFIX], 60)
          lines = [line for line in text.splitlines() if GUARD_LOG_PREFIX in line]
          out['log'] = {'count': len(lines), 'tail': lines[-20:]}
          rc, text, err = run(['journalctl', '-b', '-u', AS_UNIT, '-o', 'short-iso', '--no-pager'], 120)
          lines = text.splitlines() if rc == 0 else []
          http = [line for line in lines if 'HTTPException 401 on ' in line]
          ws = [line for line in lines if 'WebSocket' in line and 'auth' in line and 'fail' in line]
          out['server'] = {'http_401': len(http), 'websocket_auth_failed': len(ws),
                           'tail': [line[:300] for line in (http + ws)[-6:]]}
          return out


      def facts():
          manifest = load_manifest()
          tag = manifest['image']['local_tag']
          with open('/proc/sys/kernel/random/boot_id', encoding='ascii') as handle:
              boot_id = handle.read().strip()
          info = docker_json(['info', '--format', GO_JSON])
          keep = ('ServerVersion', 'DockerRootDir', 'Driver', 'DefaultRuntime', 'SecurityOptions',
                  'Runtimes', 'CgroupDriver', 'CgroupVersion', 'NCPU', 'MemTotal', 'Images',
                  'Containers', 'LoggingDriver', 'KernelVersion', 'OperatingSystem', 'Warnings',
                  'IPv4Forwarding', 'BridgeNfIptables', 'BridgeNfIp6tables', 'LiveRestoreEnabled')
          if isinstance(info, dict) and 'rc' not in info:
              info = {k: info.get(k) for k in keep}
              if isinstance(info.get('Runtimes'), dict):
                  info['Runtimes'] = sorted(info['Runtimes'])
          version = docker_json(['version', '--format', GO_JSON])
          image = docker_json(['image', 'inspect', tag])
          if isinstance(image, list) and len(image) == 1:
              image = {k: image[0].get(k) for k in ('Id', 'RepoTags', 'RepoDigests', 'Created')}
          try:
              with open(DAEMON_JSON, encoding='utf-8') as handle:
                  daemon_json = json.load(handle)
          except (OSError, ValueError) as exc:
              daemon_json = {'error': str(exc)}
          rc, listeners, err = run(['ss', '-ltnpH'], 30)
          host_config = {'sysctl': read_text(SYSCTL_FILE),
                         'containerd_config': read_text(CONTAINERD_CONFIG)}
          data = {'schema': FACTS_SCHEMA, 'boot_id': boot_id, 'collected_at': now(),
                  'version': version, 'info': info, 'images': docker_json(
                      ['image', 'ls', '--all', '--no-trunc', '--format', GO_JSON], many=True),
                  'image': image, 'containers': docker_json(
                      ['ps', '--all', '--no-trunc', '--format', GO_JSON], many=True),
                  'daemon_json': daemon_json, 'tcp_listeners': listeners.splitlines() if rc == 0
                  else {'rc': rc, 'error': tail(err, 600)},
                  'sockets': socket_facts(), 'modules': loaded_modules(), 'ipv6': ipv6_state(),
                  'host_config': host_config}
          units = ('docker.service', 'docker.socket', 'containerd.service', FACTS_UNIT, AS_UNIT)
          data['units'] = {u: run(['systemctl', 'is-enabled', u], 30)[1].strip() for u in units}
          try:
              data['agent_server'] = agent_server_facts(manifest)
          except Exception as exc:              # recorded, never fatal to the Moby facts
              data['agent_server'] = {'error': (type(exc).__name__ + ': ' + str(exc))[:500]}
          try:
              data['admission'] = admission_facts()
          except Exception as exc:              # recorded, never fatal to the Moby facts
              data['admission'] = {'error': (type(exc).__name__ + ': ' + str(exc))[:500]}
          # the report is agent-readable: a secret value never reaches it (counted, redacted)
          text, counts = redact(json.dumps(data, sort_keys=True), secret_values())
          if any(counts.values()):
              data = json.loads(text)
          data['secret_occurrences_in_report'] = counts
          os.makedirs(FACTS_DIR, mode=0o755, exist_ok=True)
          write_json(FACTS, data, 0o644)
          say('facts written for boot ' + boot_id)
          return 0


      # ---------------------------------------------------------------- conversation facts (on request)

      def container_view(c):
          """The fields of docker container inspect that F-04.2 compares: image, user, mounts,
          host configuration, published port, network, labels. Environment by name only."""
          config, host = c.get('Config') or {}, c.get('HostConfig') or {}
          net, state = c.get('NetworkSettings') or {}, c.get('State') or {}
          names = sorted(str(e).partition('=')[0] for e in config.get('Env') or [])
          keep_host = ('Binds', 'Mounts', 'NetworkMode', 'PortBindings', 'PublishAllPorts', 'CapAdd',
                       'CapDrop', 'SecurityOpt', 'Privileged', 'ReadonlyRootfs', 'ExtraHosts', 'Memory',
                       'MemorySwap', 'NanoCpus', 'CpuShares', 'CpuQuota', 'PidsLimit', 'Ulimits',
                       'AutoRemove', 'UsernsMode', 'PidMode', 'IpcMode', 'UTSMode', 'CgroupnsMode',
                       'Devices', 'DeviceCgroupRules', 'Runtime', 'RestartPolicy', 'LogConfig', 'Init',
                       'Sysctls', 'GroupAdd', 'Dns', 'DnsOptions', 'DnsSearch', 'VolumesFrom', 'Links',
                       'Tmpfs', 'ShmSize', 'CgroupParent', 'OomKillDisable', 'VolumeDriver')
          networks = {}
          for name, n in (net.get('Networks') or {}).items():
              networks[name] = {k: (n or {}).get(k) for k in (
                  'NetworkID', 'IPAddress', 'IPPrefixLen', 'Gateway', 'GlobalIPv6Address',
                  'IPv6Gateway', 'MacAddress', 'Aliases', 'DNSNames')}
          return {'Id': c.get('Id'), 'Name': c.get('Name'), 'Created': c.get('Created'),
                  'Image': c.get('Image'), 'Driver': c.get('Driver'), 'Platform': c.get('Platform'),
                  'AppArmorProfile': c.get('AppArmorProfile'),
                  'State': {k: state.get(k) for k in ('Status', 'Running', 'Paused', 'Restarting',
                                                      'OOMKilled', 'Pid', 'ExitCode', 'StartedAt',
                                                      'FinishedAt')},
                  'Config': {'User': config.get('User'), 'Image': config.get('Image'),
                             'Labels': config.get('Labels'), 'Entrypoint': config.get('Entrypoint'),
                             'Cmd': config.get('Cmd'), 'ExposedPorts': config.get('ExposedPorts'),
                             'WorkingDir': config.get('WorkingDir'), 'EnvNames': names},
                  'HostConfig': {k: host.get(k) for k in keep_host},
                  'Mounts': c.get('Mounts'),
                  'NetworkSettings': {'Ports': net.get('Ports'), 'Networks': networks},
                  }


      def container_secret_values(c):
          """{label: value} of a conversation container's secret environment values, for
          redaction only (never written)."""
          out = {}
          for entry in (c.get('Config') or {}).get('Env') or []:
              name, sep, value = str(entry).partition('=')
              # a short value is no credential, and replacing it would corrupt the report
              if sep and len(value) >= 16 and (name in CONTAINER_SECRET_VARS or
                                               SECRET_NAME.search(name)):
                  out['container ' + str(c.get('Id', ''))[:12] + ' ' + name] = value
          return out


      def container_files(cid):
          """The resolv.conf and hosts that Moby wrote for the container (its name resolution),
          and the noted lines of its json-file log (egress attempts, failures)."""
          if not CONTAINER_ID.match(str(cid)):
              return {'error': 'not a container id'}
          base = '/srv/scratch/docker/containers/' + cid
          out = {'resolv_conf': read_text(base + '/resolv.conf'), 'hosts': read_text(base + '/hosts')}
          path = base + '/' + cid + '-json.log'
          try:
              fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
              with os.fdopen(fd, 'rb') as handle:
                  size = os.fstat(handle.fileno()).st_size
                  handle.seek(max(0, size - LOG_TAIL))
                  data = handle.read()
          except OSError as exc:
              out['log'] = {'error': str(exc)}
              return out
          lines = []
          for raw in data.decode('utf-8', 'replace').splitlines():
              try:
                  lines.append(str(json.loads(raw).get('log', '')).rstrip('\n'))
              except (ValueError, AttributeError):
                  lines.append(raw)
          noted = [line[:400] for line in lines if LOG_NOTE.search(line)]
          out['log'] = {'bytes': size, 'lines': len(lines), 'head': [line[:400] for line in lines[:20]],
                        'noted': noted[-80:]}
          return out


      def tree_inventory(root, digest):
          """Regular files and directories under root (no link followed), at most INVENTORY_MAX:
          relative path, kind, size, mode, owner; sha256 of files up to HASH_MAX when digest."""
          out, truncated = [], 0
          for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
              dirnames.sort()
              for name in sorted(dirnames) + sorted(filenames):
                  path = os.path.join(dirpath, name)
                  if len(out) >= INVENTORY_MAX:
                      truncated += 1
                      continue
                  entry = stat_entry(path)
                  entry['path'] = os.path.relpath(path, root)
                  if entry['state'] == 'file':
                      entry['size'] = os.lstat(path).st_size
                      if digest and entry['size'] <= HASH_MAX:
                          entry['sha256'] = sha256_path(path)
                  out.append(entry)
          return {'entries': out, 'truncated': truncated}


      def event_summaries(directory):
          """id, kind, source and timestamp of each persisted event file (no other content)."""
          out = []
          try:
              names = sorted(os.listdir(directory))
          except OSError:
              return out
          for name in names:
              path = os.path.join(directory, name)
              if not name.endswith('.json') or not stat.S_ISREG(os.lstat(path).st_mode) or \
                      os.lstat(path).st_size > HASH_MAX:
                  continue
              try:
                  fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
                  with os.fdopen(fd, encoding='utf-8') as handle:
                      event = json.load(handle)
              except (OSError, ValueError) as exc:
                  out.append({'file': name, 'error': type(exc).__name__})
                  continue
              event = event if isinstance(event, dict) else {}
              out.append({'file': name, 'id': event.get('id'), 'kind': event.get('kind'),
                          'source': event.get('source'), 'timestamp': event.get('timestamp')})
          return out


      def conversation_storage(conversations_path):
          """Every conversation directory (files, sizes, sha256, event summaries), the runtime
          control files by name and size (their content is encrypted key material) and every
          runtime data directory by name and size."""
          out = {'conversations': dict(), 'runtime_control': [], 'runtime_data': dict()}
          try:
              names = sorted(os.listdir(conversations_path))
          except OSError as exc:
              names, out['conversations_error'] = [], str(exc)
          for name in names:
              path = os.path.join(conversations_path, name)
              out['conversations'][name] = dict(stat_entry(path), tree=tree_inventory(path, True),
                                                events=event_summaries(os.path.join(path, 'events')))
          control = os.path.join(AS_PERSISTENCE, 'runtime-control')
          try:
              for name in sorted(os.listdir(control)):
                  entry = stat_entry(os.path.join(control, name))
                  entry['size'] = os.lstat(os.path.join(control, name)).st_size
                  out['runtime_control'].append(entry)
          except OSError as exc:
              out['runtime_control_error'] = str(exc)
          data = os.path.join(AS_PERSISTENCE, 'runtime-data')
          try:
              for name in sorted(os.listdir(data)):
                  path = os.path.join(data, name)
                  out['runtime_data'][name] = dict(stat_entry(path), tree=tree_inventory(path, False))
          except OSError as exc:
              out['runtime_data_error'] = str(exc)
          return out


      def listener_facts():
          """root's ss -ltnpH, and for each listener of docker-proxy or dockerd its pid and argv
          (docker-proxy names the container address and port it forwards to)."""
          rc, out, err = run(['ss', '-ltnpH'], 30)
          if rc != 0:
              return {'error': 'ss exited ' + str(rc) + ': ' + tail(err, 300)}, []
          lines, proxies = out.splitlines(), []
          for line in lines:
              match = re.search(r'users:\(\("([^"]+)",pid=(\d+)', line)
              if not match or match.group(1) not in PROXY_PROCESSES:
                  continue
              try:
                  with open('/proc/' + match.group(2) + '/cmdline', 'rb') as handle:
                      argv = [a.decode('utf-8', 'replace') for a in handle.read().split(b'\0') if a]
              except OSError as exc:
                  argv = ['unreadable: ' + str(exc)]
              proxies.append({'local': line.split()[3] if len(line.split()) > 3 else None,
                              'process': match.group(1), 'pid': int(match.group(2)), 'argv': argv})
          return lines, proxies


      def conversation_facts():
          """On request (aieh-conversation-facts.path): a read-only report of the containers
          that carry the Agent Server's owner label, the TCP listeners and the stored
          conversations. The request file is removed, never read. Container commands: docker
          ps and docker container inspect only. Every secret value is counted and redacted."""
          started = time.monotonic()
          request = {'consumed': False}
          try:
              os.unlink(REQUEST)
              request['consumed'] = True
          except FileNotFoundError:
              pass
          except OSError as exc:
              request['error'] = type(exc).__name__
          with open('/proc/sys/kernel/random/boot_id', encoding='ascii') as handle:
              boot_id = handle.read().strip()
          try:
              with open(CONV_FACTS, encoding='utf-8') as handle:
                  serial = int(json.load(handle).get('serial', 0)) + 1
          except (OSError, ValueError, TypeError, AttributeError):
              serial = 1
          manifest = load_manifest()
          config = manifest['agent_server']['config']
          values = dict(secret_values())
          listed = docker_json(['ps', '--all', '--no-trunc', '--filter', 'label=' + OWNER_LABEL,
                                '--format', GO_JSON], many=True)
          rc, out, err = run(['docker', 'ps', '--all', '--quiet', '--no-trunc'], 60)
          all_ids = out.split() if rc == 0 else None
          ids = [c.get('ID') for c in listed] if isinstance(listed, list) else []
          containers, files = [], {}
          if ids:
              inspected = docker_json(['container', 'inspect'] + ids)
              if isinstance(inspected, list):
                  for c in inspected:
                      values.update(container_secret_values(c))
                      containers.append(container_view(c))
                      files[c.get('Id')] = container_files(c.get('Id'))
              else:
                  containers = inspected
          lines, proxies = listener_facts()
          try:
              user = pwd.getpwnam(AS_USER)
              server_user = {'name': user.pw_name, 'uid': user.pw_uid, 'gid': user.pw_gid}
          except KeyError:
              server_user = {'name': AS_USER, 'state': 'absent'}
          data = {'schema': CONV_FACTS_SCHEMA, 'boot_id': boot_id, 'serial': serial,
                  'started_monotonic': started, 'collected_at': now(), 'request': request,
                  'owner_label': OWNER_LABEL, 'listed': listed, 'containers': containers,
                  'containers_all_count': None if all_ids is None else len(all_ids),
                  'container_files': files, 'tcp_listeners': lines, 'proxies': proxies,
                  'ip_local_port_range': read_text('/proc/sys/net/ipv4/ip_local_port_range').split(),
                  'server_user': server_user,
                  'storage': conversation_storage(config['conversations_path']),
                  'server_journal': unit_journal(values),
                  'units': {u: run(['systemctl', 'is-enabled', u], 30)[1].strip()
                            for u in (CONV_PATH_UNIT, CONV_FACTS_UNIT)},
                  'admission': admission_counters(),
                  }
          # the report is agent-readable: no secret value reaches it (counted, redacted)
          text, counts = redact(json.dumps(data, sort_keys=True), values)
          data = json.loads(text)
          totals = {}
          for label, count in counts.items():
              name = label.rsplit(' ', 1)[-1]
              totals[name] = totals.get(name, 0) + count
          data['secret_values_redacted'] = len(values)
          data['secret_occurrences_in_report'] = totals
          data['seconds'] = round(time.monotonic() - started, 2)
          os.makedirs(FACTS_DIR, mode=0o755, exist_ok=True)
          write_json(CONV_FACTS, data, 0o644)
          say('conversation facts ' + str(serial) + ': ' + str(len(ids)) + ' container(s)')
          return 0


      # ---------------------------------------------------------------- provision (once)

      def copy_upload(manifest, agent_uid):
          st = os.lstat(UPLOAD)
          if not stat.S_ISDIR(st.st_mode) or st.st_uid != agent_uid:
              raise Failed('copy: ' + UPLOAD + ' is not a directory owned by agent (or is a link)')
          dirfd = os.open(UPLOAD, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
          copied = []
          try:
              extra = sorted(set(os.listdir(dirfd)) - {f['name'] for f in manifest['files']} - {READY})
              for entry in manifest['files']:
                  name, size = entry['name'], entry['size']
                  src = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dirfd)
                  try:
                      if not stat.S_ISREG(os.fstat(src).st_mode):
                          raise Failed('copy: ' + name + ' is not a regular file')
                      dst = os.open(os.path.join(STAGING, name),
                                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                      count = 0
                      with os.fdopen(dst, 'wb') as out:
                          while True:
                              block = os.read(src, 1 << 20)
                              if not block:
                                  break
                              count += len(block)
                              if count > size:
                                  raise Failed('copy: ' + name + ' is larger than the manifest says')
                              out.write(block)
                          out.flush()
                          os.fsync(out.fileno())
                  finally:
                      os.close(src)
                  if count != size:
                      raise Failed('copy: ' + name + ' has ' + str(count) + ' bytes, the manifest says ' +
                                   str(size))
                  copied.append(name)
          finally:
              os.close(dirfd)
          return {'copied': copied, 'ignored_extra_names': extra}


      def verify_staging(manifest):
          out = []
          for entry in manifest['files']:
              path = os.path.join(STAGING, entry['name'])
              st = os.lstat(path)
              got = sha256_path(path)
              ok = stat.S_ISREG(st.st_mode) and st.st_size == entry['size'] and got == entry['sha256']
              out.append({'name': entry['name'], 'role': entry['role'], 'size': st.st_size,
                          'sha256': got, 'match': ok})
              if not ok:
                  raise Failed('verify: ' + entry['name'] + ' has sha256 ' + got + ', the manifest says ' +
                               entry['sha256'])
          return {'files': out}


      def write_daemon_json(manifest):
          if os.path.lexists(DAEMON_JSON):
              raise Failed('daemon-json: ' + DAEMON_JSON + ' already exists')
          os.makedirs(os.path.dirname(DAEMON_JSON), mode=0o755, exist_ok=True)
          write_json(DAEMON_JSON, manifest['docker']['daemon_json'], 0o644)
          return {'path': DAEMON_JSON, 'content': manifest['docker']['daemon_json']}


      def write_text(path, text):
          tmp = path + '.partial'
          if os.path.lexists(tmp):
              os.unlink(tmp)
          fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
          with os.fdopen(fd, 'w', encoding='utf-8') as handle:
              handle.write(text)
              handle.flush()
              os.fsync(handle.fileno())
          os.chmod(tmp, 0o644)
          os.rename(tmp, path)


      def write_sysctl(manifest):
          """Before the install: no IPv6 on Moby's bridge and veth interfaces (profiles P7),
          applied by udev's systemd-sysctl rule as each interface appears."""
          if os.path.lexists(SYSCTL_FILE):
              raise Failed('sysctl: ' + SYSCTL_FILE + ' already exists')
          write_text(SYSCTL_FILE, manifest['docker']['sysctl'])
          return {'path': SYSCTL_FILE, 'content': manifest['docker']['sysctl']}


      def apt_install(manifest):
          debs = ['./' + f['name'] for f in manifest['files'] if f['role'] == 'deb']
          before = loaded_modules()
          out = must('apt-install', ['apt-get', 'install', '-y', '--no-install-recommends'] + debs,
                     1800, cwd=STAGING)
          names = [p['name'] for p in manifest.get('packages') or []]
          query = must('apt-install', ['dpkg-query', '-W', '-f', '${Package} ${Version} ${Status}\\n']
                       + names, 60)
          installed = {}
          for line in query.splitlines():
              parts = line.split(' ', 2)
              if len(parts) == 3:
                  installed[parts[0]] = {'version': parts[1], 'status': parts[2]}
          for p in manifest.get('packages') or []:
              got = installed.get(p['name']) or {}
              if got.get('version') != p['version'] or got.get('status') != 'install ok installed':
                  raise Failed('apt-install: ' + p['name'] + ' is ' + repr(got) + ', the manifest says ' +
                               p['version'])
          return {'debs': debs, 'installed': installed, 'modules_before': before,
                  'output_tail': tail(out, 1500)}


      def containerd_config(manifest):
          """After the install: replace containerd's packaged config.toml (a conffile, so it is
          not written before dpkg) with the declared one, which turns the CRI plugin and its
          TCP streaming listener off; then restart containerd and the daemon."""
          query = must('containerd-config', ['dpkg-query', '-W', '-f', '${Conffiles}\\n',
                                             'containerd'], 60)
          packaged = {}
          for line in query.splitlines():
              parts = line.split()
              if len(parts) >= 2:
                  packaged[parts[0]] = parts[1]
          with open(CONTAINERD_CONFIG, 'rb') as handle:
              before = hashlib.md5(handle.read()).hexdigest()
          if packaged.get(CONTAINERD_CONFIG) != before:
              raise Failed('containerd-config: ' + CONTAINERD_CONFIG + ' is not the packaged file')
          write_text(CONTAINERD_CONFIG, manifest['docker']['containerd_config'])
          must('containerd-config', ['systemctl', 'restart', 'containerd.service'], 300)
          must('containerd-config', ['systemctl', 'restart', 'docker.service'], 300)
          return {'path': CONTAINERD_CONFIG, 'replaced_packaged_md5': before,
                  'content': manifest['docker']['containerd_config']}


      def docker_ready(manifest):
          must('docker-ready', ['systemctl', 'start', 'docker.service'], 300)
          version = json.loads(must('docker-ready', ['docker', 'version', '--format', GO_JSON], 120))
          server = (version.get('Server') or {}).get('Version')
          if server != manifest['docker']['server_version']:
              raise Failed('docker-ready: server version ' + repr(server) + ', the manifest says ' +
                           manifest['docker']['server_version'])
          listeners, moby_owned = moby_tcp_listeners()
          if moby_owned:
              raise Failed('docker-ready: a TCP listener of Moby: ' + repr(moby_owned))
          return {'server_version': server, 'client_version': (version.get('Client') or {}).get('Version'),
                  'modules_after_start': loaded_modules(), 'tcp_listeners': listeners}


      def check_admission(manifest):
          """S-01.3.1, right after Moby's first start and before the Agent Server exists: the
          container guard is active with the declared rules in both families, docker.service
          requires it, and the default bridge has icc off."""
          step = 'admission'
          must(step, ['systemctl', 'enable', GUARD_UNIT], 60)
          found = admission_facts()
          if (found['guard_unit'].get('ActiveState') != 'active' or
                  not found['rules'].get('ok') or not found['docker_requires_guard'] or
                  not found['docker_after_guard'] or found['bridge_enable_icc'] != 'false'):
              raise Failed(step + ': ' + json.dumps(found, sort_keys=True)[:1500])
          return found


      def inspect_image(ref):
          data = json.loads(must('image', ['docker', 'image', 'inspect', ref], 120))
          if not isinstance(data, list) or len(data) != 1:
              raise Failed('image: docker image inspect ' + ref + ' did not return one image')
          return {k: data[0].get(k) for k in ('Id', 'RepoTags', 'RepoDigests')}


      def load_image(manifest):
          archive = os.path.join(STAGING, manifest['image']['archive'])
          out = must('docker-load', ['docker', 'load', '--input', archive], 1800)
          return {'output': tail(out, 1000)}


      def check_image_id(manifest):
          image = manifest['image']
          found = [inspect_image(tag) for tag in image['archive_repo_tags']]
          ids = sorted({f['Id'] for f in found})
          if ids != [image['id']]:
              raise Failed('image-id: the loaded image ID is ' + repr(ids) + ', the manifest says ' +
                           image['id'])
          return {'id': ids[0], 'loaded_as': found}


      def fix_tag(manifest):
          image = manifest['image']
          must('tag', ['docker', 'tag', image['id'], image['local_tag']], 120)
          removed = []
          for tag in image['archive_repo_tags']:
              if tag != image['local_tag']:
                  must('tag', ['docker', 'image', 'rm', tag], 120)
                  removed.append(tag)
          now_tagged = inspect_image(image['local_tag'])
          if now_tagged['Id'] != image['id'] or now_tagged['RepoTags'] != [image['local_tag']]:
              raise Failed('tag: ' + image['local_tag'] + ' is ' + repr(now_tagged))
          ids = must('tag', ['docker', 'image', 'ls', '--all', '--quiet', '--no-trunc'], 120).split()
          if sorted(set(ids)) != [image['id']]:
              raise Failed('tag: the image store holds ' + repr(sorted(set(ids))))
          return {'removed_tags': removed, 'image': now_tagged, 'store': sorted(set(ids))}


      def verify_run(manifest):
          tag = manifest['image']['local_tag']
          argv = ['docker', 'run', '--rm', '--entrypoint', 'true', tag]
          t0 = time.time()
          rc, out, err = run(argv, 300)
          left = must('run', ['docker', 'ps', '--all', '--quiet', '--no-trunc'], 60).split()
          ipv6 = ipv6_state()
          result = {'argv': argv, 'rc': rc, 'seconds': round(time.time() - t0, 1),
                    'output': tail(out + err, 600), 'containers_left': left, 'ipv6_after': ipv6}
          if rc != 0 or left:
              raise Failed('run: ' + ' '.join(argv) + ' exited ' + str(rc) + ' (containers left ' +
                           repr(left) + '): ' + tail(err or out, 400))
          if ipv6['docker0_disable_ipv6'] != '1' or ipv6['addresses']:
              raise Failed('run: IPv6 on a Moby interface after the run: ' + repr(ipv6))
          return result


      def copy_file(src, dst, mode):
          """A regular file copied without following links into a new file (no overwrite)."""
          fd_in = os.open(src, os.O_RDONLY | os.O_NOFOLLOW)
          try:
              if not stat.S_ISREG(os.fstat(fd_in).st_mode):
                  raise Failed('agent-server-install: ' + src + ' is not a regular file')
              tmp = dst + '.partial'
              fd_out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
              with os.fdopen(fd_out, 'wb') as out:
                  while True:
                      block = os.read(fd_in, 1 << 20)
                      if not block:
                          break
                      out.write(block)
                  out.flush()
                  os.fsync(out.fileno())
          finally:
              os.close(fd_in)
          os.chmod(tmp, mode)
          if os.path.lexists(dst):
              raise Failed('agent-server-install: ' + dst + ' already exists')
          os.rename(tmp, dst)


      def install_agent_server(manifest):
          """The system user openhands (no login shell, group docker), its scratch directories,
          the release binary (copied from the verified staging copy and hashed again) and the
          non-secret config."""
          conf = manifest['agent_server']
          step = 'agent-server-install'
          try:
              pwd.getpwnam(AS_USER)
              raise Failed(step + ': user ' + AS_USER + ' already exists (single use)')
          except KeyError:
              pass
          try:
              grp.getgrnam('docker')
          except KeyError:
              raise Failed(step + ': group docker does not exist')
          for path in (AS_BINARY, os.path.dirname(AS_BINARY), AS_CONFIG):
              if os.path.lexists(path):
                  raise Failed(step + ': ' + path + ' already exists (single use)')
          must(step, ['useradd', '--system', '--user-group', '--groups', 'docker', '--home-dir',
                      conf['home'], '--no-create-home', '--shell', AS_SHELL, '--comment',
                      'OpenHands Agent Server (AIEH)', AS_USER], 60)
          user = pwd.getpwnam(AS_USER)
          made = []
          for d in conf['directories']:                # parents before children
              mode = int(d['mode'], 8)
              os.mkdir(d['path'], mode)
              os.chown(d['path'], user.pw_uid, user.pw_gid, follow_symlinks=False)
              os.chmod(d['path'], mode)
              made.append(stat_entry(d['path']))
          os.makedirs(os.path.dirname(AS_BINARY), mode=0o755)
          copy_file(os.path.join(STAGING, conf['binary']['name']), AS_BINARY, 0o755)
          got = sha256_path(AS_BINARY)
          if got != conf['binary']['sha256']:
              raise Failed(step + ': ' + AS_BINARY + ' has sha256 ' + got + ', the manifest says ' +
                           conf['binary']['sha256'])
          os.makedirs(os.path.dirname(AS_CONFIG), mode=0o755, exist_ok=True)
          write_json(AS_CONFIG, conf['config'], 0o644)
          return {'user': {'name': user.pw_name, 'uid': user.pw_uid, 'home': user.pw_dir,
                           'shell': user.pw_shell,
                           'groups': must(step, ['id', '-nG', AS_USER], 30).split()},
                  'directories': made, 'binary': dict(stat_entry(AS_BINARY), sha256=got),
                  'config': dict(stat_entry(AS_CONFIG), sha256=sha256_path(AS_CONFIG))}


      def write_secret_file(path, text, mode, gid):
          fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
          with os.fdopen(fd, 'w', encoding='ascii') as handle:
              os.fchown(handle.fileno(), 0, gid)
              os.fchmod(handle.fileno(), mode)
              handle.write(text)
              handle.flush()
              os.fsync(handle.fileno())


      def agent_server_secrets(manifest):
          """OH_SECRET_KEY and the session API key, generated here and written only to the
          root-only environment file; the session key also to its agent-readable file, which
          the host fetches into the instance directory. Only fingerprints are returned."""
          step = 'agent-server-secrets'
          for path in (AS_SECRETS, AS_SESSION_DIR):
              if os.path.lexists(path):
                  raise Failed(step + ': ' + path + ' already exists (single use)')
          values = {name: secrets.token_urlsafe(32) for name in AS_SECRET_VARS}
          if len(set(values.values())) != len(values) or \
                  not all(SECRET_VALUE.match(v) for v in values.values()):
              raise Failed(step + ': generated values are not distinct 43-character tokens')
          write_secret_file(AS_SECRETS, ''.join(n + '=' + values[n] + '\n' for n in AS_SECRET_VARS),
                            0o600, 0)
          agent_gid = pwd.getpwnam(AGENT).pw_gid
          os.mkdir(AS_SESSION_DIR, 0o750)
          os.chown(AS_SESSION_DIR, 0, agent_gid, follow_symlinks=False)
          os.chmod(AS_SESSION_DIR, 0o750)
          write_secret_file(AS_SESSION_KEY, values['OH_SESSION_API_KEYS_0'], 0o440, agent_gid)
          prints = {n: fingerprint(v) for n, v in values.items()}
          return {'env_file': stat_entry(AS_SECRETS), 'session_dir': stat_entry(AS_SESSION_DIR),
                  'session_key': stat_entry(AS_SESSION_KEY), 'variables': list(AS_SECRET_VARS),
                  'fingerprints': prints}


      def start_agent_server(manifest):
          """Enable and start the unit; its ExecStartPost returns once GET /ready answers 200.
          Then exactly the declared listener belongs to the Agent Server, and none to Moby."""
          step = 'agent-server-start'
          listener = manifest['agent_server']['listener']
          must(step, ['systemctl', 'daemon-reload'], 120)
          rc, out, err = run(['systemctl', 'enable', '--now', AS_UNIT], 600)
          unit = unit_show(AS_UNIT, AS_UNIT_PROPERTIES)
          if rc != 0 or unit.get('ActiveState') != 'active':
              journal = unit_journal(secret_values())
              raise Failed(step + ': ' + AS_UNIT + ' is ' + repr(unit.get('ActiveState')) +
                           ' (systemctl exited ' + str(rc) + ': ' + tail(err or out, 300) +
                           '); log: ' + tail('\n'.join(journal['head'] + journal['noted']), 1200))
          lines, moby_owned = moby_tcp_listeners()
          want = listener['address'] + ':' + str(listener['port'])
          mine = sorted({line.split()[3] for line in lines if '(("' + AS_PROCESS + '"' in line
                         and len(line.split()) > 3})
          if mine != [want] or moby_owned:
              raise Failed(step + ': the Agent Server listens on ' + repr(mine) + ' (declared ' + want +
                           '); Moby listeners ' + repr(moby_owned))
          return {'unit': unit, 'listeners': lines, 'agent_server_listeners': mine}


      def enable_conversation_facts(manifest):
          """The on-demand conversation facts (F-04.2): the request directory (root:agent 0730:
          agent may create the request file, list nothing), the path unit that starts the
          reporter when the file exists, and one first report (no container yet)."""
          step = 'conversation-facts'
          if os.path.lexists(REQUEST_DIR):
              raise Failed(step + ': ' + REQUEST_DIR + ' already exists (single use)')
          agent_gid = pwd.getpwnam(AGENT).pw_gid
          os.mkdir(REQUEST_DIR, 0o730)
          os.chown(REQUEST_DIR, 0, agent_gid, follow_symlinks=False)
          os.chmod(REQUEST_DIR, 0o730)
          must(step, ['systemctl', 'enable', '--now', CONV_PATH_UNIT], 120)
          must(step, ['systemctl', 'start', CONV_FACTS_UNIT], 300)
          with open(CONV_FACTS, encoding='utf-8') as handle:
              data = json.load(handle)
          if data.get('schema') != CONV_FACTS_SCHEMA or data.get('containers') != []:
              raise Failed(step + ': the first report is ' + repr({k: data.get(k) for k in (
                  'schema', 'containers', 'listed')})[:600])
          return {'request_dir': stat_entry(REQUEST_DIR), 'units': data.get('units'),
                  'serial': data.get('serial'), 'containers': data.get('containers'),
                  'containers_all_count': data.get('containers_all_count'),
                  'seconds': data.get('seconds')}


      def enable_facts():
          must('facts', ['systemctl', 'enable', FACTS_UNIT], 60)
          must('facts', ['systemctl', 'start', FACTS_UNIT], 300)
          with open(FACTS, encoding='utf-8') as handle:
              data = json.load(handle)
          server = data.get('agent_server') or {}
          return {'unit': FACTS_UNIT, 'enabled': run(['systemctl', 'is-enabled', FACTS_UNIT], 30)[1].strip(),
                  'boot_id': data.get('boot_id'), 'info': data.get('info'),
                  'sockets': data.get('sockets'), 'tcp_listeners': data.get('tcp_listeners'),
                  'modules': data.get('modules'),
                  'agent_server': {k: server.get(k) for k in ('enabled', 'engine', 'error')},
                  'secret_occurrences_in_report': data.get('secret_occurrences_in_report')}


      def cleanup():
          shutil.rmtree(STAGING)
          st = os.lstat(UPLOAD)
          if not stat.S_ISDIR(st.st_mode):
              raise Failed('cleanup: ' + UPLOAD + ' is not a directory')
          shutil.rmtree(UPLOAD)
          left = [p for p in (STAGING, UPLOAD) if os.path.lexists(p)]
          if left:
              raise Failed('cleanup: still present ' + repr(left))
          return {'removed': [STAGING, UPLOAD]}


      def disable_trigger():
          """Single use in every outcome: the trigger is disabled, stopped and removed."""
          out = {}
          out['disable'] = run(['systemctl', 'disable', '--now', PATH_UNIT], 120)[0]
          if os.path.lexists(PATH_UNIT_FILE):
              os.unlink(PATH_UNIT_FILE)
          out['daemon_reload'] = run(['systemctl', 'daemon-reload'], 120)[0]
          out['path_unit_file'] = 'present' if os.path.lexists(PATH_UNIT_FILE) else 'absent'
          out['is_enabled'] = {u: run(['systemctl', 'is-enabled', u], 30)[1].strip()
                               for u in (PATH_UNIT, 'aieh-provision.service')}
          return out


