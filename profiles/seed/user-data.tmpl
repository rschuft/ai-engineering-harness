    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/python3
      # aieh-container-guard (S-01.3.1): no new connection from a container bridge to the guest
      # itself. In the filter table's INPUT chain, a packet from docker0 or a br-* bridge that
      # does not belong to a connection the guest opened jumps to AIEH-CONTAINER-GUARD: it is
      # logged (rate-limited, kernel log at the LOG target's default level warning, this
      # prefix) and refused, TCP with a reset, anything
      # else with an ICMP port-unreachable. IPv4 and IPv6 alike. Forwarded traffic is untouched.
      # Run by aieh-container-guard.service, which docker.service requires (fail closed: no
      # rules, no Moby). Modes: (none) install and verify; check: verify only. Prints one JSON
      # line: the rules as iptables -S prints them, and whether they are the declared ones.
      import json
      import shlex
      import subprocess
      import sys

      CHAIN = 'AIEH-CONTAINER-GUARD'
      INTERFACES = ('docker0', 'br-+')
      LOG_PREFIX = 'aieh-container-guard: '
      TOOLS = ('iptables', 'ip6tables')
      RULES = ('-m conntrack --ctstate RELATED,ESTABLISHED -j RETURN',
               '-m limit --limit 10/min --limit-burst 20 -j LOG --log-prefix "' + LOG_PREFIX + '"',
               '-p tcp -j REJECT --reject-with tcp-reset',
               '-j REJECT')
      ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'}


      def run(argv):
          r = subprocess.run(argv, capture_output=True, text=True, timeout=60, env=ENV, check=False)
          return r.returncode, r.stdout, r.stderr


      def must(argv):
          rc, out, err = run(argv)
          if rc != 0:
              raise RuntimeError(' '.join(argv) + ' exited ' + str(rc) + ': ' + err.strip()[-300:])
          return out


      def install(tool):
          if run([tool, '-w', '-n', '-L', CHAIN])[0] != 0:
              must([tool, '-w', '-N', CHAIN])
          must([tool, '-w', '-F', CHAIN])
          for rule in RULES:
              must([tool, '-w', '-A', CHAIN] + shlex.split(rule))
          for iface in INTERFACES:
              while run([tool, '-w', '-D', 'INPUT', '-i', iface, '-j', CHAIN])[0] == 0:
                  pass
              must([tool, '-w', '-I', 'INPUT', '1', '-i', iface, '-j', CHAIN])


      def observe(tool):
          rc, out, err = run([tool, '-w', '-S', CHAIN])
          chain = [line for line in out.splitlines() if line.startswith('-A ')] if rc == 0 else None
          rc2, out2, _ = run([tool, '-w', '-S', 'INPUT'])
          jumps = [line for line in out2.splitlines() if line.endswith('-j ' + CHAIN)] \
              if rc2 == 0 else None
          want = ['-A ' + CHAIN + ' ' + rule for rule in RULES]
          ok = chain is not None and len(chain) == len(want) and \
              all(line == w or line.startswith(w + ' ') for line, w in zip(chain, want)) and \
              jumps is not None and sorted(jumps) == sorted(
                  '-A INPUT -i ' + i + ' -j ' + CHAIN for i in INTERFACES) and \
              out2.splitlines()[1:1 + len(INTERFACES)] == [
                  '-A INPUT -i ' + i + ' -j ' + CHAIN for i in reversed(INTERFACES)]
          return {'chain': chain, 'input_jumps': jumps, 'ok': ok,
                  'error': None if rc == 0 else err.strip()[-300:]}


      def main(argv):
          out = {'mode': 'check' if argv == ['check'] else 'install'}
          try:
              if argv not in ([], ['check']):
                  raise RuntimeError('usage: aieh-container-guard [check]')
              if not argv:
                  for tool in TOOLS:
                      install(tool)
              out['families'] = {tool: observe(tool) for tool in TOOLS}
              out['ok'] = all(f['ok'] for f in out['families'].values())
          except Exception as exc:
              out['ok'], out['error'] = False, (type(exc).__name__ + ': ' + str(exc))[:600]
          print(json.dumps(out, sort_keys=True), flush=True)
          return 0 if out['ok'] else 1


      if __name__ == '__main__':
          sys.exit(main(sys.argv[1:]))
