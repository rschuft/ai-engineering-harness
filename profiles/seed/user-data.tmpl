    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/python3
      # aieh-container-guard (S-01.3.1): no new connection from a container bridge to the guest
      # itself. In the filter table's INPUT chain, a packet from docker0 or a br-* bridge that
      # does not belong to a connection the guest opened jumps to AIEH-CONTAINER-GUARD: it is
      # logged (rate-limited, kernel log at the LOG target's default level warning, this
      # prefix) and refused, TCP with a reset, anything
      # else with an ICMP port-unreachable. IPv4 and IPv6 alike.
      # Egress guard (S-01.4): no new forwarded connection from a container bridge to any other
      # interface. Moby's DOCKER-USER chain (created here when absent: this unit runs before
      # docker.service) sends a packet that enters from docker0 or a br-* bridge and leaves by
      # another interface to AIEH-EGRESS-GUARD, which has the same four rules with its own log
      # prefix; the allowlist is empty (its first entry belongs to S-03.x, inference). Traffic
      # between two containers on one bridge stays with icc false (S-01.3.1). DOCKER-USER ends
      # with the RETURN that Moby would add, so Moby finds it and changes nothing, and FORWARD
      # jumps to DOCKER-USER first (Moby re-inserts that jump at the top for IPv4).
      # Run by aieh-container-guard.service, which docker.service requires (fail closed: no
      # rules, no Moby). Modes: (none) install and verify; check: verify only. Prints one JSON
      # line: the rules as iptables -S prints them, and whether they are the declared ones.
      import json
      import shlex
      import subprocess
      import sys

      CHAIN = 'AIEH-CONTAINER-GUARD'
      INTERFACES = ('docker0', 'br-+')
      LOG_PREFIX = 'aieh-container-guard: '
      TOOLS = ('iptables', 'ip6tables')
      RULES = ('-m conntrack --ctstate RELATED,ESTABLISHED -j RETURN',
               '-m limit --limit 10/min --limit-burst 20 -j LOG --log-prefix "' + LOG_PREFIX + '"',
               '-p tcp -j REJECT --reject-with tcp-reset',
               '-j REJECT')
      EGRESS_CHAIN = 'AIEH-EGRESS-GUARD'
      EGRESS_HOOK = 'DOCKER-USER'
      EGRESS_LOG_PREFIX = 'aieh-egress-guard: '
      EGRESS_ALLOWLIST = ()
      EGRESS_RULES = ('-m conntrack --ctstate RELATED,ESTABLISHED -j RETURN',
                      '-m limit --limit 10/min --limit-burst 20 -j LOG --log-prefix "' +
                      EGRESS_LOG_PREFIX + '"',
                      '-p tcp -j REJECT --reject-with tcp-reset',
                      '-j REJECT')
      ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'}


      def run(argv):
          r = subprocess.run(argv, capture_output=True, text=True, timeout=60, env=ENV, check=False)
          return r.returncode, r.stdout, r.stderr


      def must(argv):
          rc, out, err = run(argv)
          if rc != 0:
              raise RuntimeError(' '.join(argv) + ' exited ' + str(rc) + ': ' + err.strip()[-300:])
          return out


      def install(tool):
          if run([tool, '-w', '-n', '-L', CHAIN])[0] != 0:
              must([tool, '-w', '-N', CHAIN])
          must([tool, '-w', '-F', CHAIN])
          for rule in RULES:
              must([tool, '-w', '-A', CHAIN] + shlex.split(rule))
          for iface in INTERFACES:
              while run([tool, '-w', '-D', 'INPUT', '-i', iface, '-j', CHAIN])[0] == 0:
                  pass
              must([tool, '-w', '-I', 'INPUT', '1', '-i', iface, '-j', CHAIN])


      def egress_rules():
          # the allowlist (empty in S-01.4) would sit between the RETURN and the LOG
          return EGRESS_RULES[:1] + tuple(EGRESS_ALLOWLIST) + EGRESS_RULES[1:]


      def egress_hook_rules():
          return ['-A ' + EGRESS_HOOK + ' -i ' + i + ' ! -o ' + i + ' -j ' + EGRESS_CHAIN
                  for i in INTERFACES] + ['-A ' + EGRESS_HOOK + ' -j RETURN']


      def install_egress(tool):
          for chain in (EGRESS_HOOK, EGRESS_CHAIN):
              if run([tool, '-w', '-n', '-L', chain])[0] != 0:
                  must([tool, '-w', '-N', chain])
          must([tool, '-w', '-F', EGRESS_CHAIN])
          for rule in egress_rules():
              must([tool, '-w', '-A', EGRESS_CHAIN] + shlex.split(rule))
          must([tool, '-w', '-F', EGRESS_HOOK])
          for line in egress_hook_rules():
              must([tool, '-w'] + shlex.split(line))
          while run([tool, '-w', '-D', 'FORWARD', '-j', EGRESS_HOOK])[0] == 0:
              pass
          must([tool, '-w', '-I', 'FORWARD', '1', '-j', EGRESS_HOOK])


      def observe_egress(tool):
          rc, out, err = run([tool, '-w', '-S', EGRESS_CHAIN])
          chain = [line for line in out.splitlines() if line.startswith('-A ')] if rc == 0 else None
          rc2, out2, _ = run([tool, '-w', '-S', EGRESS_HOOK])
          hook = [line for line in out2.splitlines() if line.startswith('-A ')] if rc2 == 0 else None
          rc3, out3, _ = run([tool, '-w', '-S', 'FORWARD'])
          forward = out3.splitlines() if rc3 == 0 else []
          rules = [line for line in forward if line.startswith('-A ')]
          jumps = [line for line in rules if line.endswith(' -j ' + EGRESS_HOOK)]
          want = ['-A ' + EGRESS_CHAIN + ' ' + rule for rule in egress_rules()]
          ok = chain is not None and len(chain) == len(want) and \
              all(line == w or line.startswith(w + ' ') for line, w in zip(chain, want)) and \
              hook == egress_hook_rules() and rules[:1] == ['-A FORWARD -j ' + EGRESS_HOOK] and \
              len(jumps) == 1
          return {'chain': chain, 'hook': hook, 'forward_head': rules[:4],
                  'forward_jumps': len(jumps) if rc3 == 0 else None,
                  'forward_policy': next((line for line in forward if line.startswith('-P ')), None),
                  'ok': ok, 'error': None if rc == 0 else err.strip()[-300:]}


      def observe(tool):
          rc, out, err = run([tool, '-w', '-S', CHAIN])
          chain = [line for line in out.splitlines() if line.startswith('-A ')] if rc == 0 else None
          rc2, out2, _ = run([tool, '-w', '-S', 'INPUT'])
          jumps = [line for line in out2.splitlines() if line.endswith('-j ' + CHAIN)] \
              if rc2 == 0 else None
          want = ['-A ' + CHAIN + ' ' + rule for rule in RULES]
          ok = chain is not None and len(chain) == len(want) and \
              all(line == w or line.startswith(w + ' ') for line, w in zip(chain, want)) and \
              jumps is not None and sorted(jumps) == sorted(
                  '-A INPUT -i ' + i + ' -j ' + CHAIN for i in INTERFACES) and \
              out2.splitlines()[1:1 + len(INTERFACES)] == [
                  '-A INPUT -i ' + i + ' -j ' + CHAIN for i in reversed(INTERFACES)]
          return {'chain': chain, 'input_jumps': jumps, 'ok': ok,
                  'error': None if rc == 0 else err.strip()[-300:]}


      def main(argv):
          out = {'mode': 'check' if argv == ['check'] else 'install'}
          try:
              if argv not in ([], ['check']):
                  raise RuntimeError('usage: aieh-container-guard [check]')
              if not argv:
                  for tool in TOOLS:
                      install(tool)
                      install_egress(tool)
              out['families'] = {tool: dict(observe(tool), egress=observe_egress(tool))
                                 for tool in TOOLS}
              out['egress_ok'] = all(f['egress']['ok'] for f in out['families'].values())
              out['ok'] = all(f['ok'] for f in out['families'].values()) and out['egress_ok']
          except Exception as exc:
              out['ok'], out['error'] = False, (type(exc).__name__ + ': ' + str(exc))[:600]
          print(json.dumps(out, sort_keys=True), flush=True)
          return 0 if out['ok'] else 1


      if __name__ == '__main__':
          sys.exit(main(sys.argv[1:]))
